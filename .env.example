# Set this to the project homepage or maintainer contact URL after coordinating
# with Transitous. Rail lookups remain unavailable while this value is blank.
TRANSITOUS_CONTACT_URL=

# Transitous API endpoint; the application default is shown here.
TRANSITOUS_API_BASE_URL=https://api.transitous.org/api

# Local SQLite cache TTLs, in seconds.
TRANSITOUS_ROUTE_TTL_SECONDS=21600
TRANSITOUS_EMPTY_ROUTE_TTL_SECONDS=900
