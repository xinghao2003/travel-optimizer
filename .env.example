# Public contact link for browser Transitous use and the optional proxy's User-Agent.
# The native build and optional proxy default to this repository when unset.
TRANSITOUS_CONTACT_URL=https://github.com/xinghao2003/travel-optimizer

# Transitous API endpoint; the application default is shown here.
TRANSITOUS_API_BASE_URL=https://api.transitous.org/api

# Native static build settings. These values are public in browser-data/config.json.
# Export these variables in the build environment before generating static assets.
BROWSER_FLIGHTS_URL=/api/flights
BROWSER_TRANSIT_URL=https://api.transitous.org/api/v6/plan
BROWSER_TRANSIT_ENABLED=true
# Optional proxy instead of direct browser requests: BROWSER_TRANSIT_URL=/api/transit

# Function-side CORS for a separately hosted static frontend (exact origins).
# BROWSER_ALLOWED_ORIGINS=https://planner.example.com

# Local SQLite cache TTLs, in seconds.
TRANSITOUS_ROUTE_TTL_SECONDS=21600
TRANSITOUS_EMPTY_ROUTE_TTL_SECONDS=900

# Optional local planner database locations (defaults are under backend/data).
# PLANNER_DB_PATH=C:/path/to/planner.sqlite3
# PLANNER_PLACES_PATH=C:/path/to/places.sqlite3
# OSRM_BASE_URL=https://router.project-osrm.org
# PLANNER_LABEL_BATCH=25000
# Maximum additional states per calculation, including timed rounds. Continue resumes saved work.
# PLANNER_SOLVE_BATCH=100000

# Detailed planner stage/progress logs and thread dumps after 30s of API stalls.
# Files: backend/data/planner-debug.log and backend/data/planner-stacks.log.
# PLANNER_DEBUG=1
