# Catalog build settings (tools/prepare_catalogs.py). These values are public in browser-data/config.json.
# Export these variables in the build environment before generating the catalogs.
BROWSER_FLIGHTS_URL=/api/flights
BROWSER_TRANSIT_URL=https://api.transitous.org/api/v6/plan
BROWSER_TRANSIT_ENABLED=true
# Public contact link sent with Transitous requests. Defaults to this repository.
TRANSITOUS_CONTACT_URL=https://github.com/xinghao2003/travel-optimizer
# OSRM_BASE_URL=https://router.project-osrm.org

# Flight function CORS for a separately hosted static frontend (exact origins).
# BROWSER_ALLOWED_ORIGINS=https://planner.example.com
