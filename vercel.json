{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "devCommand": "npm --prefix frontend run catalogs && npm --prefix frontend run dev",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/flights.py": {
      "maxDuration": 60,
      "includeFiles": "backend/app/{__init__,flight_provider}.py",
      "excludeFiles": "{data/**,frontend/**,backend/tests/**,tools/**,docs/**,.venv/**}"
    }
  }
}
