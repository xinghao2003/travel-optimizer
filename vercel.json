{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix app ci",
  "buildCommand": "npm --prefix app run build",
  "devCommand": "npm --prefix app run catalogs && npm --prefix app run dev",
  "outputDirectory": "app/dist",
  "functions": {
    "api/flights.py": {
      "maxDuration": 60,
      "includeFiles": "api/_flight_provider.py",
      "excludeFiles": "{data/**,app/**,tests/**,tools/**,docs/**,.venv/**}"
    }
  }
}
